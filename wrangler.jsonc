// Cloudflare Workers config: publish the built site in dist/ as static files.
// There is no server code. Visitors' saved sites stay in their own browsers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selenes-compass",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist"
  }
}
