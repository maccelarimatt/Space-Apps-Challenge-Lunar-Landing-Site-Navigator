{
  "name": "lunar-landing-site-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Selene's Compass, a lunar landing site navigator. Compare lunar landing sites and dates by Sun and Earth visibility above the local horizon. NASA Space Apps Challenge 2026. Code written with AI assistance (Claude), see README.",
  "scripts": {
    "start": "node scripts/server.mjs start",
    "stop": "node scripts/server.mjs stop",
    "status": "node scripts/server.mjs status",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data": "tsx scripts/build-data.ts"
  },
  "dependencies": {
    "@fontsource/marcellus-sc": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.17.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
